<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="tabmuenster.App">

    <!--
        Hier kannst du globale Ressourcen definieren:
        - Farben
        - Styles
        - DataTemplates
        - ControlTemplates
    -->

    <Application.Resources>
        <ResourceDictionary>
            <!-- Beispiel: globale Farbdefinitionen -->
            <!--Color x:Key="PrimaryColor">#2D8B29</Color-->
            <Color x:Key="PrimaryColor">#196F3D</Color>             <!-- dunkleres Grün, Kontrast zu weiß ≈ 5.7:1 -->
            <!--Color x:Key="SecondaryColor">#E30D2D</Color-->
            <Color x:Key="SecondaryColor">#A50F1A</Color>            <!-- dunkleres Rot, Kontrast zu weiß > 7:1 -->

            <!-- Beispiel für einen globalen Style -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="Black"/>
            </Style>
            <!-- Lokalisierbares Format für Accessibility-Name von Listeneinträgen -->
            <x:String x:Key="AccessibleNameFormat">{0}, {1}: {2}</x:String>
        </ResourceDictionary>
    </Application.Resources>
</Application>
