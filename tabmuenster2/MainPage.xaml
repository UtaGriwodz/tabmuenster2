<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="tabmuenster.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:tabmuenster"
    x:DataType="local:MainPage"
    Title="Aufgaben der Taschengeldbörse Münster">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Label" x:Key="CategoryLabel">
                <!--Setter Property="TextColor" Value="#2D8B29" /-->
                <Setter Property="TextColor" Value="#196F3D" />   <!-- dunkleres Grün, besserer Kontrast -->
                <Setter Property="FontFamily" Value="" />
                <Setter Property="FontSize" Value="24" />
            </Style>
            <Style TargetType="Label" x:Key="QuartierLabel">
                <!--Setter Property="TextColor" Value="#E30D2D" /-->
                <Setter Property="TextColor" Value="#A50F1A" />   <!-- dunkleres Rot, besserer Kontrast -->
                <Setter Property="FontFamily" Value="" />
            </Style>
            <Style TargetType="Label" x:Key="DescLabel">
                <Setter Property="TextColor" Value="#444" />
                <Setter Property="FontFamily" Value="" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Padding="5">
        <!-- Header (CHANGED: Grid statt StackLayout für stabile Positionierung auf allen Geräten) -->
        <Grid Padding="10" BackgroundColor="#e8e8e8" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto">
            <!-- App-Icon -->
            <Image Source="ic_launcher_round.png"
                   WidthRequest="65"
                   HeightRequest="65"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"
                   Grid.Column="0"
                   AutomationProperties.IsInAccessibleTree="False" />

            <!-- Titel: adaptive Schriftgröße, immer eine Zeile (keine Umbrüche) -->
            <Label Text="Taschengeldbörse"
       TextColor="#196F3D"
       VerticalTextAlignment="Center"
       HorizontalTextAlignment="Center"
       LineBreakMode="TailTruncation"
       MaxLines="1"
       Grid.Column="1"
       VerticalOptions="Center"
       HorizontalOptions="FillAndExpand"
       AutomationProperties.Name="Haupttitel: Taschengeldbörse">
                <VisualStateManager.VisualStateGroups>
                    <!-- CHANGED -->
                <VisualStateGroup x:Name="AdaptiveStates">
                        <!-- very narrow phones -->
                        <VisualState x:Name="Narrow">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Property="FontSize" Value="16" />
                            </VisualState.Setters>
                        </VisualState>

                        <!-- small phones -->
                        <VisualState x:Name="Small">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="360" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Property="FontSize" Value="20" />
                            </VisualState.Setters>
                        </VisualState>

                        <!-- typical phones / tablets -->
                        <VisualState x:Name="Medium">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="480" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Property="FontSize" Value="26" />
                            </VisualState.Setters>
                        </VisualState>

                        <!-- large screens -->
                        <VisualState x:Name="Wide">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="720" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Property="FontSize" Value="30" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <!-- CHANGED -->
            </Label>


            <!-- Info-Button rechts, immer sichtbar -->
            <ImageButton Source="icons8_information.png"
                         WidthRequest="44"
                         HeightRequest="44"
                         BackgroundColor="Transparent"
                         VerticalOptions="Center"
                         HorizontalOptions="End"
                         Margin="6,0,0,0"
                         Clicked="ButtonImpressumClicked"
                         Grid.Column="2"
                         SemanticProperties.Description="Info"
                         SemanticProperties.Hint="Informationen zur Taschengeldbörse"
                         AutomationProperties.Name="Info" />
        </Grid>

        <!-- List -->
        <ListView x:Name="AufgabenListView"
          Grid.Row="1"
          ItemsSource="{Binding aufgaben}"
          ItemTapped="OnTap"
          ItemSelected="OnSelection"
          HasUnevenRows="True"
          SeparatorVisibility="Default"
          SeparatorColor="#E0E0E0">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:Aufgabe">
                    <ViewCell AutomationProperties.Name="{Binding AccessibleName}"
                              AutomationProperties.HelpText="{Binding Aufgabenbeschreibung}">
                        <Grid Padding="8" ColumnDefinitions="Auto, *" RowDefinitions="Auto,Auto,Auto,Auto">
                            <Image Source="{Binding Kategoriebild}" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" Grid.Row="0" Grid.RowSpan="2" AutomationProperties.IsInAccessibleTree="False" />

                            <Label Text="{Binding Kategorie}"
                 Style="{StaticResource CategoryLabel}"
                 Grid.Column="1" Grid.Row="0"
                 VerticalOptions="Start" />

                            <Label Text="{Binding Quartier}"
                 Style="{StaticResource QuartierLabel}"
                 Grid.Column="1" Grid.Row="1"
                 VerticalOptions="Start" LineBreakMode="TailTruncation" MaxLines="1" />

                            <Label Text="{Binding Aufgabenbeschreibung}"
                 Style="{StaticResource DescLabel}"
                 Grid.Column="1" Grid.Row="2"
                 VerticalOptions="Start" LineBreakMode="TailTruncation" MaxLines="2" />

                            <!-- optional: manueller Separator (wenn du ListView-Separator nicht ausreichen soll) -->
                            <!--BoxView HeightRequest="1" Color="#EFEFEF" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0" HorizontalOptions="FillAndExpand"/-->
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Footer buttons -->
        <StackLayout Grid.Row="2" Orientation="Horizontal" HorizontalOptions="Center" BackgroundColor="White" Padding="10" Spacing="20">
            <ImageButton Source="icons8nachricht" Clicked="ButtonMailClicked" WidthRequest="75" HeightRequest="75"
                         AutomationProperties.Name="Nachricht schreiben" AutomationProperties.HelpText="Öffnet das E‑Mail Formular" SemanticProperties.Description="Nachricht schreiben" SemanticProperties.Hint="Öffnet das E‑Mail Formular" />
            <ImageButton Source="icons8telefon" Clicked="ButtonCallClicked" WidthRequest="75" HeightRequest="75"
                         AutomationProperties.Name="Anrufen" AutomationProperties.HelpText="Ruft die Taschengeldbörse an" SemanticProperties.Description="Anrufen" SemanticProperties.Hint="Ruft die Taschengeldbörse an" />
            <ImageButton Source="icons8_info_100_ugr" Clicked="ButtonInfoClicked" WidthRequest="75" HeightRequest="75"
                         AutomationProperties.Name="Mehr Informationen" AutomationProperties.HelpText="Zeigt weitere Informationen zur Taschengeldbörse" SemanticProperties.Description="Mehr Informationen" SemanticProperties.Hint="Zeigt weitere Informationen zur Taschengeldbörse" />
        </StackLayout>
    </Grid>
</ContentPage>
