<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- App-Name, der unter dem Icon angezeigt wird -->
    <key>CFBundleDisplayName</key>
    <string>Taschengeldbörse Münster</string>

    <!-- Eindeutiger Bundle-Identifier -->
    <!-- WICHTIG: Für Updates im App Store muss dieser mit dem bisherigen Identifier identisch bleiben -->
    <key>CFBundleIdentifier</key>
    <string>com.companyname.tabmuenster</string>

    <!-- Versionen – beim nächsten Release anpassen -->
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>

    <!-- Mindest-iOS-Version, die du unterstützen möchtest -->
    <key>MinimumOSVersion</key>
    <string>11.0</string>

    <!-- Haupt-Storyboard (Launchscreen) – Standardwert für MAUI -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <!-- App-Icons – MAUI verwendet normalerweise AppIcon aus Assets.xcassets -->
    <key>XSAppIconAssets</key>
    <string>Assets.xcassets/AppIcon.appiconset</string>

    <!-- Geräteausrichtung -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- iPad-Spezifische Ausrichtungen -->
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Falls deine App Telefon/SMS/E-Mail nutzt, sind keine speziellen Entitlements nötig,
         aber du kannst optionale Nutzungsbeschreibungen ergänzen -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Diese App benötigt Zugriff auf die Fotobibliothek, um Bilder auszuwählen (falls verwendet).</string>
    <key>NSCameraUsageDescription</key>
    <string>Diese App benötigt Zugriff auf die Kamera, um Fotos aufnehmen zu können (falls verwendet).</string>
    <key>NSContactsUsageDescription</key>
    <string>Diese App benötigt Zugriff auf Kontakte, um Telefonnummern oder E-Mails auszuwählen (falls verwendet).</string>

</dict>
</plist>
